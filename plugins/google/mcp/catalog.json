    "chronicle": {
      "kind": "remote",
      "status": "verified",
      "title": "Google Security Operations (Chronicle)",
      "official": true,
      "toolCount": 70,
      "schemaBytes": 3809280,
      "measuredAt": "2026-08-05",
      "config": {
        "type": "http",
        "url": "https://chronicle.${SECOPS_REGION:-us}.rep.googleapis.com/mcp"
      },
      "urlTemplate": "https://chronicle.<REGION>.rep.googleapis.com/mcp",
      "variables": {
        "SECOPS_REGION": {
          "default": "us",
          "verified": [
            "us",
            "europe-west2",
            "europe-west3",
            "europe-west6",
            "europe-west9",
            "asia-south1",
            "asia-southeast1",
            "australia-southeast1",
            "me-west1"
          ],
          "description": "Regional REP endpoint. Verified to resolve: us, europe-west2/3/6/9, asia-south1, asia-southeast1, australia-southeast1, me-west1. Note that a bare `europe` does NOT resolve — it must be a specific region."
        }
      },
      "scopes": [
        "https://www.googleapis.com/auth/cloud-platform"
      ],
      "auth": "oauth-no-dcr",
      "warning": "3.7 MB of schema across 70 tools — by far the most expensive server here, ~8x cloudsql. Only enable it in a project that genuinely does SecOps.",
      "notes": "Tool count and schema size measured in `us` only; the other regions were confirmed to resolve but not measured. An earlier revision recorded this as unavailable because it was probed without a region."
    },
