      "config": {
        "type": "http",
        "url": "https://agentregistry.googleapis.com/mcp"
      },
      "scopes": [
        "https://www.googleapis.com/auth/cloud-platform"
      ],
      "auth": "oauth-no-dcr",
      "notes": "Catalogued from Google's supported-products page; never probed, so its tool count and schema cost are unknown."
    },
